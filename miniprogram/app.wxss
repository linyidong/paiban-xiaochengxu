/* 设计令牌（T-001）：所有页面共用。
   迁移说明：页面级硬编码样式在 T-013～T-015 分批替换；本文件只负责全局基座。 */
page {
  --color-bg: #F3F7FF;
  --color-surface: #FFFFFF;
  --color-text: #16233A;
  --color-text-secondary: #4A5A6A;
  --color-text-muted: #5F6F80;
  --color-primary: #2563EB;
  --color-primary-strong: #1D4ED8;
  --color-danger: #B91C1C;
  --color-warning: #B45309;
  --color-warning-strong: #92400E;
  --color-success: #166534;
  --color-primary-tint: #EAF2FF;
  --color-blue: #1D4ED8;
  --color-blue-tint: #EAF2FF;
  --color-blue-tint-strong: #DBEAFE;
  --color-blue-border: #BFDBFE;
  --color-blue-text: #1E40AF;
  --color-blue-text-strong: #1E3A8A;
  --color-danger-tint: #FEF2F2;
  --color-border: #DFE7F2;

  --font-size-title: 40rpx;
  --font-size-body: 32rpx;
  --font-size-caption: 28rpx;

  --radius-card: 20rpx;
  --radius-btn: 12rpx;

  --space-page: 32rpx;
  --space-card: 32rpx;

  --shadow-card: 0 2rpx 8rpx rgba(22, 35, 58, 0.06);

  background: var(--color-bg);
  color: var(--color-text);
  font-size: var(--font-size-body);
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--space-card);
  margin: 20rpx var(--space-page);
  box-shadow: var(--shadow-card);
}

.btn-primary {
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-btn);
  font-size: var(--font-size-body);
  padding: 24rpx 0;
  text-align: center;
  line-height: 1.4;
}
.btn-primary::after { border: none; }
.btn-primary:active { background: var(--color-primary-strong); }

.btn-ghost {
  background: var(--color-surface);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-btn);
  font-size: var(--font-size-body);
  padding: 22rpx 0;
  text-align: center;
  line-height: 1.4;
}
.btn-ghost::after { border: none; }
.btn-ghost:active { background: #EAF2FF; }
