/* 日历组件样式：使用设计 token，并带 fallback（组件样式隔离时变量可能不继承） */
.week-row { display: flex; }
.week-cell {
  width: 14.28%; text-align: center;
  color: var(--color-text-muted, #5F6E69);
  font-size: 26rpx; padding: 12rpx 0;
}
.day-grid { display: flex; flex-wrap: wrap; }
.day-cell {
  width: 14.28%; height: 104rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.day-cell.dim { opacity: 0.35; }
.day-cell.selected {
  background: #ECFDF5;
  border-radius: 16rpx;
  box-shadow: inset 0 0 0 2rpx var(--color-primary, #0F766E);
}
.day-num { font-size: 32rpx; color: var(--color-text, #14231F); }
.day-shift {
  margin-top: 6rpx; font-size: 22rpx; color: #FFFFFF;
  border-radius: 8rpx; padding: 2rpx 12rpx;
}
