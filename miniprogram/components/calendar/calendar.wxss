.week-row { display: flex; }
.week-cell { width: 14.28%; text-align: center; color: #9CA3AF; font-size: 24rpx; padding: 12rpx 0; }
.day-grid { display: flex; flex-wrap: wrap; }
.day-cell { width: 14.28%; height: 96rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.day-cell.dim { opacity: 0.3; }
.day-cell.selected { background: #DBEAFE; border-radius: 16rpx; box-shadow: inset 0 0 0 2rpx #3B82F6; }
.day-num { font-size: 26rpx; color: #1F2937; }
.day-shift { margin-top: 4rpx; font-size: 20rpx; color: #FFFFFF; border-radius: 8rpx; padding: 2rpx 14rpx; }
