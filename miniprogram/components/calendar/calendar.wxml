<view class="cal-wrap">
  <view class="week-row">
    <view class="week-cell" wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</view>
  </view>
  <view class="day-grid">
    <view class="day-cell {{item.inMonth ? '' : 'dim'}} {{item.selected ? 'selected' : ''}}" wx:for="{{cells}}" wx:key="fullDate"
          data-date="{{item.fullDate}}" data-shift="{{item.shift}}" data-inmonth="{{item.inMonth}}" bindtap="onTap" bindlongpress="onLongPress">
      <view class="day-num">{{item.day}}</view>
      <view class="day-shift" wx:if="{{item.shift}}" style="background: {{item.color}}">{{item.shift}}</view>
    </view>
  </view>
</view>
