/* 我的页样式：使用设计 token（T-015 迁移） */
.mine-page { padding-bottom: 40rpx; }
.mine-name { font-size: 40rpx; font-weight: 600; color: var(--color-text); }
.mine-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; color: var(--color-text); }
.stat-row { display: flex; }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 56rpx; font-weight: 600; }
.stat-num.shu { color: var(--color-danger); }
.stat-num.bai { color: var(--color-primary); }
.stat-num.wan { color: var(--color-text); }
.stat-label { font-size: 28rpx; color: var(--color-text-secondary); margin-top: 4rpx; }
.mine-link {
  font-size: 32rpx; color: var(--color-primary); padding: 16rpx 0;
  min-height: 88rpx; box-sizing: border-box; display: flex; align-items: center;
}
.mine-link.logout { color: var(--color-danger); }

/* 未绑定提示 */
.mine-bindtip {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #FEF3C7;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--color-warning-strong);
  text-align: center;
}
.mine-bindbtn { margin-top: 12rpx; color: var(--color-primary); font-weight: 600; }
