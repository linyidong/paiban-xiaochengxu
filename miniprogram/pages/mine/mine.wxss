/* 我的页样式：使用设计 token（T-015 迁移） */
.mine-page { padding-bottom: 40rpx; }
.mine-name { font-size: 40rpx; font-weight: 600; color: var(--color-text); }
.mine-name-tip { margin-top: 12rpx; font-size: 26rpx; color: var(--color-text-muted); line-height: 1.6; }
.mine-editbtn { color: var(--color-primary); margin-left: 12rpx; }
.mine-edit { margin-top: 20rpx; }
.mine-edit-input {
  width: 100%; box-sizing: border-box;
  background: var(--color-bg);
  border: 2rpx solid var(--color-primary);
  border-radius: 10rpx;
  padding: 16rpx 18rpx;
  font-size: 32rpx;
  color: var(--color-text);
}
.mine-edit-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.mine-save, .mine-cancel {
  flex: 1; text-align: center; font-size: 30rpx; padding: 16rpx 0; border-radius: 10rpx;
}
.mine-save { color: #FFFFFF; background: var(--color-primary); }
.mine-cancel { color: var(--color-text-secondary); background: var(--color-bg); }
.mine-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; color: var(--color-text); }
.stat-row { display: flex; }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 56rpx; font-weight: 600; }
.stat-num.shu { color: var(--color-danger); }
.stat-num.bai { color: var(--color-primary); }
.stat-num.wan { color: var(--color-text); }
.stat-label { font-size: 28rpx; color: var(--color-text-secondary); margin-top: 4rpx; }
.mine-link {
  font-size: 32rpx; color: var(--color-primary); padding: 16rpx 0;
  min-height: 88rpx; box-sizing: border-box; display: flex; align-items: center;
}
.mine-link.logout { color: var(--color-danger); }

/* 未绑定提示 */
.mine-bindtip {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #FEF3C7;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--color-warning-strong);
  text-align: center;
}
.mine-bindbtn { margin-top: 12rpx; color: var(--color-primary); font-weight: 600; }
