<view class="mine-page">
  <view class="card">
    <view class="mine-name">成员昵称：{{hasBound ? displayName : '未绑定'}}</view>
    <view class="mine-name-tip" wx:if="{{hasBound && !editingName}}">
      显示名默认取导入昵称；如果这是真实姓名，可以改成昵称
      <text class="mine-editbtn" bindtap="onStartRename">修改</text>
    </view>
    <view class="mine-edit" wx:if="{{editingName}}">
      <input class="mine-edit-input" value="{{newName}}" placeholder="输入新的显示名称" bindinput="onNameInput" focus />
      <view class="mine-edit-actions">
        <view class="mine-save" bindtap="onSaveName">{{savingName ? '保存中…' : '保存'}}</view>
        <view class="mine-cancel" bindtap="onCancelRename">取消</view>
      </view>
    </view>
    <view class="mine-bindtip" wx:if="{{!hasBound && !isAdmin}}">
      请先绑定成员身份才能查看排班
      <view class="mine-bindbtn" bindtap="goBind">去绑定 →</view>
    </view>
  </view>

  <view class="card" wx:if="{{hasBound && summary}}">
    <view class="mine-title">本月我的排班</view>
    <view class="stat-row">
      <view class="stat-item">
        <view class="stat-num shu">{{summary['休']}}</view>
        <view class="stat-label">休</view>
      </view>
      <view class="stat-item">
        <view class="stat-num bai">{{summary['白']}}</view>
        <view class="stat-label">白班</view>
      </view>
      <view class="stat-item">
        <view class="stat-num wan">{{summary['晚']}}</view>
        <view class="stat-label">晚班</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="mine-link" bindtap="goMemo">添加备忘录 →</view>
  </view>

  <view class="card" wx:if="{{isAdmin}}">
    <view class="mine-link" bindtap="goMembers">成员管理 →</view>
  </view>

  <view class="card" wx:if="{{isAdmin}}">
    <view class="mine-link" bindtap="goTechstack">技术栈 →</view>
  </view>

  <view class="card" wx:if="{{isAdmin}}">
    <view class="mine-link" bindtap="goSettings">设置 →</view>
  </view>

  <view class="card" wx:if="{{isAdmin}}">
    <view class="mine-link" bindtap="goData">数据 →</view>
  </view>

  <view class="card">
    <view class="mine-link logout" bindtap="onLogout">退出登录</view>
  </view>
</view>
