<view class="members-page">
  <view class="card">
    <view class="members-title">成员列表（{{members.length}}）</view>
    <view class="members-add-toggle" bindtap="onToggleAdd">{{showAdd ? '取消新增' : '+ 新增成员'}}</view>
    <view class="members-add-form" wx:if="{{showAdd}}">
      <input class="members-add-input" placeholder="输入成员姓名（与排班表一致）" value="{{newName}}" bindinput="onNewNameInput" />
      <button class="btn-primary members-add-btn" bindtap="onAddMember" loading="{{adding}}">确认新增</button>
    </view>
    <view class="member-row" wx:for="{{members}}" wx:key="_id">
      <view class="member-info">
        <view class="member-name">{{item.displayName}}</view>
        <view class="member-meta">
          <text class="member-role">{{item.role === 'admin' ? '管理员' : '成员'}}</text>
          <text class="member-bindstatus {{item.openid ? 'bound' : 'unbound'}}">
            {{item.openid ? '已绑定微信' : '未绑定'}}
          </text>
        </view>
        <view class="member-openid" wx:if="{{item.openid}}">
          <text class="openid-label">OpenID：</text>
          <text class="openid-value">{{item.openid}}</text>
        </view>
      </view>
      <view class="member-actions">
        <view class="member-action-btn unbind" wx:if="{{item.openid && item.role !== 'admin'}}"
              data-id="{{item._id}}" data-name="{{item.name}}" bindtap="onUnbind">解绑</view>
        <view class="member-action-btn remove" wx:if="{{item.role !== 'admin'}}"
              data-id="{{item._id}}" data-name="{{item.name}}" bindtap="onRemove">移除</view>
      </view>
    </view>
  </view>
</view>
