<view class="members-page">
  <view class="card">
    <view class="members-title">成员列表（{{members.length}}）</view>
    <view class="members-add-toggle" bindtap="onToggleAdd">{{showAdd ? '取消新增' : '+ 新增成员'}}</view>
    <view class="members-add-form" wx:if="{{showAdd}}">
      <input class="members-add-input" placeholder="输入成员姓名（与排班表一致）" value="{{newName}}" bindinput="onNewNameInput" />
      <button class="btn-primary members-add-btn" bindtap="onAddMember" loading="{{adding}}">确认新增</button>
    </view>
    <view class="member-row" wx:for="{{members}}" wx:key="_id">
      <view class="member-info">
        <block wx:if="{{editingId === item._id}}">
          <input class="member-rename-input" value="{{editingName}}" bindinput="onRenameInput" focus placeholder="输入新昵称" />
          <input class="member-rename-input member-realname-input" value="{{editingRealName}}" bindinput="onRealNameInput" placeholder="真实姓名（可留空）" />
          <view class="member-meta">
            <text class="member-role">昵称和真实姓名都可修改；排班按成员ID关联，不会丢</text>
          </view>
        </block>
        <block wx:else>
          <view class="member-name">{{item.displayName}}</view>
          <view class="member-meta">
            <text class="member-role">{{item.role === 'admin' ? '管理员' : '成员'}}</text>
            <text class="member-bindstatus {{item.isBound ? 'bound' : 'unbound'}}">
              {{item.isBound ? '已绑定微信' : '未绑定'}}
            </text>
          </view>
          <view class="member-realname">真实姓名：{{item.realName || '未绑定真实姓名'}}</view>
        </block>
      </view>
      <view class="member-actions">
        <block wx:if="{{editingId === item._id}}">
          <view class="member-action-btn save" data-id="{{item._id}}" bindtap="onSaveRename">保存</view>
          <view class="member-action-btn cancel" bindtap="onCancelRename">取消</view>
        </block>
        <block wx:else>
          <view class="member-action-btn rename" wx:if="{{item.role !== 'admin'}}"
                data-id="{{item._id}}" data-name="{{item.name}}" data-realname="{{item.realName}}" bindtap="onStartRename">改资料</view>
          <view class="member-action-btn unbind" wx:if="{{item.isBound && item.role !== 'admin'}}"
                data-id="{{item._id}}" data-name="{{item.name}}" bindtap="onUnbind">解绑</view>
          <view class="member-action-btn remove" wx:if="{{item.role !== 'admin'}}"
                data-id="{{item._id}}" data-name="{{item.name}}" bindtap="onRemove">移除</view>
        </block>
      </view>
    </view>
  </view>
</view>
