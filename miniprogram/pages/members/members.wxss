.members-page { padding-bottom: 40rpx; }
.members-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }
.member-row {
  display: flex; align-items: flex-start; justify-content: space-between;
  padding: 24rpx 0; border-bottom: 2rpx solid #F3F4F6;
}
.member-row:last-child { border-bottom: none; }
.member-info { flex: 1; }
.member-name { font-size: 30rpx; font-weight: 500; }
.member-meta { display: flex; gap: 16rpx; margin-top: 8rpx; align-items: center; }
.member-role { font-size: 24rpx; color: #6B7280; }
.member-bindstatus { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.member-bindstatus.bound { background: #DCFCE7; color: #16A34A; }
.member-bindstatus.unbound { background: #F3F4F6; color: #9CA3AF; }
.member-openid { margin-top: 8rpx; }
.openid-label { font-size: 22rpx; color: #9CA3AF; }
.openid-value { font-size: 22rpx; color: #6B7280; word-break: break-all; }
.member-actions { display: flex; gap: 12rpx; flex-shrink: 0; }
.member-action-btn {
  font-size: 24rpx; padding: 8rpx 16rpx; border-radius: 8rpx;
}
.member-action-btn.unbind { color: #F59E0B; background: #FEF3C7; }
.member-action-btn.remove { color: #EF4444; background: #FEE2E2; }
