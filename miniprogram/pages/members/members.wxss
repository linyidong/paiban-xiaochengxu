/* 成员管理页样式：使用设计 token（T-015 迁移） */
.members-page { padding-bottom: 40rpx; }
.members-title { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; color: var(--color-text); }
.members-add-toggle {
  font-size: 30rpx; color: var(--color-primary);
  padding: 20rpx 0; min-height: 88rpx; box-sizing: border-box;
}
.members-add-form { margin-bottom: 24rpx; }
.members-add-input {
  background: var(--color-bg); border-radius: 12rpx; padding: 22rpx 24rpx;
  font-size: 32rpx; margin-bottom: 16rpx; box-sizing: border-box; width: 100%;
  color: var(--color-text);
}
.members-add-btn { font-size: 32rpx; padding: 18rpx 0; }
.member-row {
  display: flex; align-items: flex-start; justify-content: space-between;
  padding: 24rpx 0; border-bottom: 2rpx solid var(--color-border);
}
.member-row:last-child { border-bottom: none; }
.member-info { flex: 1; }
.member-name { font-size: 32rpx; font-weight: 500; color: var(--color-text); }
.member-meta { display: flex; gap: 16rpx; margin-top: 8rpx; align-items: center; }
.member-role { font-size: 28rpx; color: var(--color-text-secondary); }
.member-bindstatus { font-size: 26rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.member-bindstatus.bound { background: #DCFCE7; color: var(--color-success); }
.member-bindstatus.unbound { background: var(--color-bg); color: var(--color-text-muted); }
.member-actions { display: flex; gap: 12rpx; flex-shrink: 0; }
.member-action-btn {
  font-size: 28rpx; padding: 0 20rpx; border-radius: 8rpx;
  min-height: 88rpx; display: flex; align-items: center;
}
.member-action-btn.unbind { color: var(--color-warning-strong); background: #FEF3C7; }
.member-action-btn.remove { color: var(--color-danger); background: var(--color-danger-tint); }
