.calendar-page { padding-bottom: 40rpx; }
.month-bar { display: flex; align-items: center; justify-content: space-between; }
.month-title { font-size: 34rpx; font-weight: 600; }
.month-nav { font-size: 44rpx; color: #3B82F6; padding: 0 32rpx; }
.member-scroll { white-space: nowrap; padding: 8rpx 24rpx; width: 100%; box-sizing: border-box; }
.member-item {
  display: inline-block; padding: 10rpx 28rpx; background: #FFFFFF;
  border-radius: 32rpx; margin-right: 16rpx; font-size: 26rpx; color: #4B5563;
}
.member-item.active { background: #3B82F6; color: #FFFFFF; }

/* 非管理员当前成员显示 */
.member-current {
  padding: 16rpx 24rpx;
  text-align: center;
}
.member-current-label {
  font-size: 26rpx;
  color: #6B7280;
}
.member-current-name {
  font-size: 28rpx;
  color: #3B82F6;
  font-weight: 600;
}
.cal-card { padding-bottom: 16rpx; position: relative; }
.multi-btn {
  position: absolute; right: 16rpx;
  top: 480rpx;
  font-size: 26rpx; color: #3B82F6;
  background: #EFF6FF; border-radius: 12rpx; padding: 8rpx 24rpx;
}
.multi-btn.on { background: #3B82F6; color: #FFFFFF; }
.legend { display: flex; flex-direction: column; }
.legend-row { display: flex; align-items: center; justify-content: space-between; margin: 16rpx 0; }
.legend-item { display: flex; align-items: center; font-size: 26rpx; color: #4B5563; }
.dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 8rpx; }
.legend-actions { display: flex; flex-direction: column; gap: 16rpx; margin-top: 24rpx; }
.legend-act-btn {
  text-align: center; font-size: 28rpx; padding: 18rpx 0;
  border-radius: 12rpx;
}
.legend-act-delete {
  color: #EF4444; font-size: 32rpx; font-weight: 600;
  border: 2rpx solid #FEE2E2; background: #FEF2F2;
}
.multi-bar {
  display: flex; align-items: center; justify-content: space-between;
  background: #3B82F6; color: #FFFFFF; border-radius: 16rpx;
  padding: 20rpx 28rpx; margin: 16rpx 24rpx;
}
.multi-info { font-size: 28rpx; }
.multi-go { font-size: 28rpx; font-weight: 600; }
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 100; }
.picker-panel {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 16rpx; z-index: 101;
  background: #FFFFFF; border-radius: 24rpx; padding: 32rpx 24rpx 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.15);
}
.picker-title { text-align: center; font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; }
.picker-grid { display: flex; flex-wrap: wrap; }
.picker-item {
  width: 25%; display: flex; flex-direction: column; align-items: center;
  padding: 20rpx 0; font-size: 26rpx; color: #1F2937;
}
.picker-dot { width: 40rpx; height: 40rpx; border-radius: 50%; margin-bottom: 8rpx; }
.picker-cancel {
  margin-top: 20rpx; text-align: center; color: #9CA3AF; font-size: 28rpx; padding: 16rpx 0;
}

/* 年月选择器：下滑面板 */
.date-picker-overlay {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 100;
  background: rgba(0,0,0,0.3);
}
.date-picker-panel {
  position: fixed; left: 0; right: 0; top: 0; z-index: 101;
  background: #FFFFFF; border-radius: 0 0 24rpx 24rpx;
  padding: 32rpx 24rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.15);
  animation: slideDown 0.25s ease-out;
}
@keyframes slideDown {
  from { transform: translateY(-100%); }
  to { transform: translateY(0); }
}
.date-picker-header {
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx; position: relative;
}
.date-picker-title {
  font-size: 34rpx; font-weight: 600; color: #1F2937;
}
.date-picker-year-nav {
  font-size: 44rpx; color: #3B82F6; padding: 0 32rpx;
}
.date-picker-year-title {
  font-size: 34rpx; font-weight: 600; color: #1F2937;
  padding: 0 16rpx;
}
.date-picker-close {
  position: absolute; right: 0; top: 50%; transform: translateY(-50%);
  font-size: 36rpx; color: #9CA3AF; padding: 8rpx 16rpx;
}
.year-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx;
}
.year-cell {
  text-align: center; font-size: 30rpx; color: #1F2937;
  padding: 24rpx 0; border-radius: 12rpx;
}
.year-cell.current {
  background: #3B82F6; color: #FFFFFF; font-weight: 600;
}
.month-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx;
}
.month-cell {
  text-align: center; font-size: 28rpx; color: #1F2937;
  padding: 20rpx 0; border-radius: 12rpx;
}
.month-cell.current {
  background: #3B82F6; color: #FFFFFF; font-weight: 600;
}
.month-cell.has-data {
  background: #F3F4F6;
}

/* 无排班提示 */
.empty-tip {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 80rpx 0 40rpx;
}
.empty-icon {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: #F3F4F6; margin-bottom: 24rpx;
}
.empty-text {
  font-size: 28rpx; color: #9CA3AF;
}

/* 有排班但无备忘录提示 */
.memo-empty-tip {
  text-align: center;
  padding: 32rpx 0 16rpx;
}

/* 备忘录区域 */
.memo-section {
  padding: 24rpx 0 8rpx;
  border-top: 1rpx solid #F3F4F6;
  margin-top: 16rpx;
}
.memo-section-title {
  font-size: 28rpx; color: #6B7280; margin-bottom: 16rpx;
}
.memo-item {
  padding: 12rpx 0;
}
.memo-text {
  font-size: 32rpx; font-weight: 600; color: #374151; line-height: 1.6;
}
