/* 日历页样式：全部使用 app.wxss 的设计 token（T-013 迁移） */
.calendar-page { padding-bottom: 40rpx; }
.month-bar { display: flex; align-items: center; justify-content: space-between; }
.month-title { font-size: 40rpx; font-weight: 600; color: var(--color-text); }
.month-nav {
  font-size: 44rpx; color: var(--color-primary); padding: 0 32rpx;
  min-height: 88rpx; display: flex; align-items: center;
}
.member-scroll { white-space: nowrap; padding: 8rpx 24rpx; width: 100%; box-sizing: border-box; }
.member-item {
  display: inline-block; padding: 16rpx 28rpx; background: var(--color-blue-tint);
  border: 2rpx solid var(--color-blue-border);
  border-radius: 32rpx; margin-right: 16rpx; font-size: 30rpx;
  color: var(--color-blue-text); min-height: 88rpx; box-sizing: border-box;
}
.member-item.active {
  background: var(--color-blue-tint-strong);
  color: var(--color-blue-text-strong);
  border-color: var(--color-blue);
  font-weight: 600;
}

/* 非管理员当前成员显示：浅蓝底 */
.member-current {
  padding: 16rpx 24rpx;
  margin: 8rpx 24rpx;
  text-align: center;
  background: var(--color-blue-tint);
  border: 2rpx solid var(--color-blue-border);
  border-radius: 12rpx;
  box-sizing: border-box;
}
.member-current-label { font-size: 30rpx; color: var(--color-blue-text); }
.member-current-name { font-size: 32rpx; color: var(--color-blue-text); font-weight: 600; }

.cal-card { padding-bottom: 16rpx; position: relative; }
/* 批量按钮：与 31 号格同宽同列（14.28%），右边缘贴齐日期网格右边缘 */
.multi-btn {
  display: block;
  width: 14.28%;
  min-width: 88rpx;
  margin: 16rpx 0 0 auto;
  text-align: center;
  font-size: 28rpx; color: var(--color-blue-text);
  background: var(--color-blue-tint);
  border: 2rpx solid var(--color-blue-border);
  border-radius: 8rpx;
  padding: 0;
  line-height: 68rpx;
  min-height: 72rpx;
  box-sizing: border-box;
}
.multi-btn.on {
  background: var(--color-blue);
  color: #FFFFFF;
  border-color: var(--color-blue);
}

.legend { display: flex; flex-direction: column; }
.legend-row {
  display: flex; flex-wrap: wrap; align-items: center;
  gap: 12rpx 20rpx; margin: 16rpx 0;
}
.legend-item { display: flex; align-items: center; font-size: 28rpx; color: var(--color-text-secondary); }
.dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 8rpx; }
.legend-actions { display: flex; flex-direction: column; gap: 16rpx; margin-top: 24rpx; }
.legend-act-btn { text-align: center; font-size: 30rpx; padding: 20rpx 0; border-radius: 12rpx; min-height: 88rpx; box-sizing: border-box; }
.legend-act-delete {
  color: var(--color-danger); font-size: 32rpx; font-weight: 600;
  border: 2rpx solid #FEE2E2; background: #FEF2F2;
}

.multi-bar {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--color-primary); color: #FFFFFF; border-radius: 16rpx;
  padding: 20rpx 28rpx; margin: 16rpx 24rpx;
}
.multi-info { font-size: 30rpx; }
.multi-go { font-size: 30rpx; font-weight: 600; }

.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 100; }
.picker-panel {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 16rpx; z-index: 101;
  background: var(--color-surface); border-radius: var(--radius-card);
  padding: 32rpx 24rpx 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(20,35,31,0.15);
}
.picker-title { text-align: center; font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; color: var(--color-text); }
.picker-grid { display: flex; flex-wrap: wrap; }
.picker-item {
  width: 25%; display: flex; flex-direction: column; align-items: center;
  padding: 20rpx 0; font-size: 28rpx; color: var(--color-text);
  min-height: 120rpx; box-sizing: border-box;
}
.picker-dot { width: 40rpx; height: 40rpx; border-radius: 50%; margin-bottom: 8rpx; }
.picker-cancel {
  margin-top: 20rpx; text-align: center; color: var(--color-text-muted);
  font-size: 30rpx; padding: 20rpx 0; min-height: 88rpx; box-sizing: border-box;
}

/* 年月选择器：下滑面板 */
.date-picker-overlay {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 100;
  background: rgba(0,0,0,0.3);
}
.date-picker-panel {
  position: fixed; left: 0; right: 0; top: 0; z-index: 101;
  background: var(--color-surface); border-radius: 0 0 24rpx 24rpx;
  padding: 32rpx 24rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(20,35,31,0.15);
  animation: slideDown 0.2s ease-out;
}
@keyframes slideDown {
  from { transform: translateY(-100%); }
  to { transform: translateY(0); }
}
.date-picker-header {
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx; position: relative;
}
.date-picker-title { font-size: 40rpx; font-weight: 600; color: var(--color-text); }
.date-picker-year-nav {
  font-size: 44rpx; color: var(--color-primary); padding: 0 32rpx;
  min-height: 88rpx; display: flex; align-items: center;
}
.date-picker-year-title { font-size: 40rpx; font-weight: 600; color: var(--color-text); padding: 0 16rpx; }
.date-picker-close {
  position: absolute; right: 0; top: 50%; transform: translateY(-50%);
  font-size: 36rpx; color: var(--color-text-muted); padding: 8rpx 16rpx;
  min-height: 88rpx; min-width: 88rpx; display: flex; align-items: center; justify-content: center;
}
.year-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.year-cell {
  text-align: center; font-size: 32rpx; color: var(--color-text);
  padding: 24rpx 0; border-radius: 12rpx; min-height: 88rpx; box-sizing: border-box;
}
.year-cell.current { background: var(--color-primary); color: #FFFFFF; font-weight: 600; }
.month-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.month-cell {
  text-align: center; font-size: 32rpx; color: var(--color-text);
  padding: 24rpx 0; border-radius: 12rpx; min-height: 88rpx; box-sizing: border-box;
}
.month-cell.current { background: var(--color-primary); color: #FFFFFF; font-weight: 600; }
.month-cell.has-data { background: var(--color-bg); color: var(--color-text); }
/* 当前月且有数据：确保白字仍在主色底上（BUG-012） */
.month-cell.current.has-data { background: var(--color-primary); color: #FFFFFF; }

/* 空态 */
.empty-tip { display: flex; align-items: center; justify-content: center; padding: 80rpx 0 40rpx; }
.empty-text { font-size: 30rpx; color: var(--color-text-muted); }
.memo-empty-tip { text-align: center; padding: 32rpx 0 16rpx; }

/* 备忘录区域 */
.memo-section { padding: 24rpx 0 8rpx; border-top: 2rpx solid var(--color-border); margin-top: 16rpx; }
.memo-section-title { font-size: 28rpx; color: var(--color-text-secondary); margin-bottom: 16rpx; }
.memo-item { padding: 12rpx 0; }
.memo-text { font-size: 32rpx; font-weight: 600; color: var(--color-text); line-height: 1.6; }
