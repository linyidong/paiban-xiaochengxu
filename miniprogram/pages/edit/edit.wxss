.edit-page { padding-top: 20rpx; }
.edit-title { font-size: 36rpx; font-weight: 600; margin-bottom: 32rpx; }
.edit-row { display: flex; align-items: center; margin-bottom: 32rpx; }
.edit-label { width: 120rpx; color: #6B7280; font-size: 28rpx; flex-shrink: 0; }
.edit-value { font-size: 30rpx; font-weight: 500; }
.options { display: flex; flex-wrap: wrap; flex: 1; }
.option {
  padding: 14rpx 32rpx; background: #F3F4F6; border-radius: 16rpx;
  font-size: 28rpx; color: #1F2937; margin: 0 16rpx 16rpx 0;
  display: flex; align-items: center;
}
.option.active { background: #3B82F6; color: #FFFFFF; }
.shift-dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 12rpx; }
.edit-save { margin-top: 16rpx; }
