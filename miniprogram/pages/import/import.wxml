<view class="import-page">
  <view class="card">
    <view class="import-title">排班导入</view>
    <view class="import-desc">上传排班截图 / 表格，识别后自动生成日历</view>

    <view class="prefill-tip" wx:if="{{prefillName}}">
      <view class="prefill-title">目标：{{prefillName}} · {{targetMonth}}</view>
      <view class="prefill-sub">上传后只保留该成员；导入成功自动回到对应月份</view>
    </view>

    <!-- 目标月份：提前导入下个月（或补录过去月份）时用；不选则按截图识别结果入库 -->
    <view class="target-month">
      <view class="target-month-row">
        <view class="target-month-label">导入到哪个月</view>
        <picker class="target-month-picker" mode="date" fields="month"
                value="{{targetMonth}}" start="{{monthRange.start}}" end="{{monthRange.end}}"
                bindchange="onTargetMonthChange">
          <view class="target-month-value {{targetMonth ? 'is-set' : ''}}">
            {{targetMonth ? targetMonth : '按截图识别的月份（默认）'}}
          </view>
        </picker>
        <view class="target-month-clear" wx:if="{{targetMonth}}" bindtap="onClearTargetMonth">改回默认</view>
      </view>
      <view class="target-month-tip" wx:if="{{targetMonth}}">
        已选 {{targetMonth}}：入库日期以所选月份为准（截图上的月份会被重写，只保留「日」）
      </view>
      <view class="target-month-tip" wx:else>
        想提前导入下个月的班表？先在这里选月份，再上传截图
      </view>
    </view>

    <view class="import-actions">
      <button class="btn-primary import-btn" bindtap="onChooseImage" loading="{{loading && sourceType === 'image'}}">选择排班截图 / Excel</button>
    </view>
  </view>

  <!-- 多人识别：选择要导入谁的排班 -->
  <view class="mask" wx:if="{{showMemberSelect}}" bindtap="onCancelSelect"></view>
  <view class="member-select-panel" wx:if="{{showMemberSelect}}">
    <view class="member-select-title">识别到 {{recognizedMembers.length}} 位成员，请选择要导入谁的排班</view>
    <view class="member-select-all" wx:if="{{isAdmin}}" bindtap="onSelectAllMembers">全部导入（{{recognizedMembers.length}} 人）</view>
    <view class="member-select-list">
      <view class="member-select-item" wx:for="{{recognizedMembers}}" wx:key="name"
            data-name="{{item.name}}" bindtap="onSelectMember">
        {{item.displayName}}<text wx:if="{{item.displayName !== item.name}}">（{{item.name}}）</text>
      </view>
    </view>
    <view class="member-select-cancel" bindtap="onCancelSelect">取消</view>
  </view>

  <!-- 非管理员绑定确认弹窗 -->
  <view class="mask" wx:if="{{showBindConfirm}}"></view>
  <view class="bind-confirm-panel" wx:if="{{showBindConfirm}}">
    <view class="bind-confirm-title">识别到成员</view>
    <view class="bind-confirm-name">
      {{bindConfirmRecognizedDisplayName}}<text wx:if="{{bindConfirmRecognizedDisplayName !== bindConfirmRecognizedName}}">（{{bindConfirmRecognizedName}}）</text>
    </view>
    <view class="bind-confirm-question">是否绑定到您的成员</view>
    <view class="bind-confirm-bound">
      {{boundMemberDisplayName}}<text wx:if="{{boundMemberDisplayName !== boundMemberName}}">（{{boundMemberName}}）</text>
    </view>
    <view class="bind-confirm-actions">
      <button class="btn-primary" bindtap="onConfirmBindRecognized">确定</button>
      <button class="btn-ghost" bindtap="onCancelBindConfirm">取消</button>
    </view>
  </view>

  <view class="card" wx:if="{{preview}}">
    <view class="preview-title">识别结果预览<text wx:if="{{targetName && targetName !== '全部'}}">（{{targetName}}）</text></view>
    <view class="preview-tip">识别可能有误差，点按班次可循环切换，确认后再入库</view>
    <view class="preview-month-note" wx:if="{{previewNote}}">{{previewNote}}</view>
    <view class="member-preview" wx:for="{{preview}}" wx:key="name" wx:for-index="idx">
      <view class="member-name">{{item.displayName}}<text wx:if="{{item.displayName !== item.name}}">（{{item.name}}）</text></view>
      <view class="shift-tags">
        <view class="shift-tag" wx:for="{{item.rows}}" wx:for-item="row" wx:key="date"
              data-idx="{{idx}}" data-date="{{row.date}}" bindtap="onFixShift">
          {{row.date.slice(5)}} · {{row.shift}}
        </view>
      </view>
    </view>
    <view class="preview-actions">
      <button class="btn-primary" bindtap="onConfirm">确认导入</button>
      <button class="btn-ghost" bindtap="onCancel">取消</button>
    </view>
  </view>
</view>
