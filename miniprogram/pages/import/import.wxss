/* 导入页样式：使用设计 token（T-014 迁移） */
.import-page { padding-bottom: 40rpx; }
.import-title { font-size: 40rpx; font-weight: 600; margin-bottom: 8rpx; color: var(--color-text); }
.import-desc { color: var(--color-text-secondary); font-size: 30rpx; margin-bottom: 32rpx; }
.prefill-tip {
  background: var(--color-blue-tint);
  border: 2rpx solid var(--color-blue-border);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}
.prefill-title { font-size: 30rpx; font-weight: 600; color: var(--color-blue-text-strong); }
.prefill-sub { font-size: 26rpx; color: var(--color-text-secondary); margin-top: 4rpx; }
.import-btn { margin-bottom: 20rpx; }
.preview-title { font-size: 36rpx; font-weight: 600; margin-bottom: 8rpx; color: var(--color-text); }
.preview-tip { color: var(--color-warning); font-size: 28rpx; margin-bottom: 24rpx; }
.preview-month-note {
  color: var(--color-blue-text);
  background: var(--color-blue-tint);
  border: 2rpx solid var(--color-blue-border);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}
.member-preview { margin-bottom: 28rpx; }
.member-name { font-size: 32rpx; font-weight: 500; margin-bottom: 12rpx; color: var(--color-text); }
.shift-tags { display: flex; flex-wrap: wrap; }
.shift-tag {
  background: var(--color-bg); border-radius: 12rpx; padding: 10rpx 18rpx;
  font-size: 26rpx; color: var(--color-text); margin: 0 12rpx 12rpx 0;
}
.preview-actions { margin-top: 16rpx; }
.preview-actions button { margin-bottom: 16rpx; }
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 100; }
.member-select-panel {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 60rpx; z-index: 101;
  background: var(--color-surface); border-radius: var(--radius-card);
  padding: 32rpx 24rpx 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(20,35,31,0.15);
}
.member-select-title { text-align: center; font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; color: var(--color-text); }
.member-select-list { display: flex; flex-wrap: wrap; }
.member-select-item {
  width: 50%; text-align: center; padding: 24rpx 0; font-size: 30rpx; color: var(--color-text);
  background: var(--color-bg); border-radius: 12rpx; margin: 0 8rpx 16rpx;
  min-height: 88rpx; box-sizing: border-box;
}
.member-select-cancel {
  text-align: center; color: var(--color-text-muted); font-size: 30rpx;
  padding: 20rpx 0; margin-top: 8rpx; min-height: 88rpx; box-sizing: border-box;
}
.member-select-all {
  text-align: center; font-size: 32rpx; color: var(--color-primary);
  background: var(--color-primary-tint); border-radius: 12rpx;
  padding: 20rpx 0; margin-bottom: 16rpx; min-height: 88rpx; box-sizing: border-box;
}

/* 非管理员绑定确认弹窗 */
.bind-confirm-panel {
  position: fixed; left: 48rpx; right: 48rpx; top: 50%; z-index: 101;
  background: var(--color-surface); border-radius: var(--radius-card);
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(20,35,31,0.15);
  transform: translateY(-50%);
  text-align: center;
}
.bind-confirm-title { font-size: 28rpx; color: var(--color-text-secondary); margin-bottom: 12rpx; }
.bind-confirm-name { font-size: 40rpx; font-weight: 600; color: var(--color-text); margin-bottom: 24rpx; }
.bind-confirm-question { font-size: 28rpx; color: var(--color-text-secondary); margin-bottom: 12rpx; }
.bind-confirm-bound { font-size: 32rpx; font-weight: 600; color: var(--color-primary); margin-bottom: 32rpx; }
.bind-confirm-actions { display: flex; gap: 16rpx; }
.bind-confirm-actions button { flex: 1; font-size: 30rpx; }

/* 目标月份选择（提前导入未来月份） */
.target-month { margin-bottom: 24rpx; padding: 20rpx; background: var(--color-bg); border-radius: 12rpx; }
.target-month-row { display: flex; align-items: center; }
.target-month-label { font-size: 28rpx; color: var(--color-text-secondary); margin-right: 16rpx; flex-shrink: 0; }
.target-month-picker { flex: 1; min-width: 0; }
.target-month-value { font-size: 30rpx; color: var(--color-text-secondary); }
.target-month-value.is-set { color: var(--color-accent, #2563eb); font-weight: 600; }
.target-month-clear { font-size: 26rpx; color: var(--color-text-secondary); margin-left: 16rpx; text-decoration: underline; flex-shrink: 0; }
.target-month-tip { font-size: 24rpx; color: var(--color-text-secondary); margin-top: 10rpx; line-height: 1.5; }