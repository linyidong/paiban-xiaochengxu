<view class="settings-page">
  <view class="card">
    <view class="set-title">AI 识别模型</view>
    <view class="set-hint">主模型失败时会自动尝试备用模型；API Key 仍由云端配置保管，不下发到客户端。</view>

    <view class="set-field">
      <view class="set-label">主模型</view>
      <input class="set-input" value="{{primaryModel}}" bindinput="onPrimaryInput" placeholder="例如 doubao-..." />
    </view>

    <view class="set-field">
      <view class="set-label">备用模型（可空）</view>
      <input class="set-input" value="{{fallbackModel}}" bindinput="onFallbackInput" placeholder="主模型失败时自动使用" />
    </view>

    <button class="btn-primary set-save" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存设置</button>
  </view>

  <view class="card">
    <view class="mine-link" bindtap="goTechstack">查看技术栈 →</view>
  </view>
</view>
