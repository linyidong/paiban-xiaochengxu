.data-page { padding-bottom: 40rpx; }
.data-title { font-size: 36rpx; font-weight: 600; color: var(--color-text); }
.data-sub { font-size: 26rpx; color: var(--color-text-muted); margin: 6rpx 0 26rpx; }
.data-grid { display: flex; flex-wrap: wrap; }
.data-item {
  width: 50%;
  box-sizing: border-box;
  padding: 22rpx 12rpx;
  text-align: center;
}
.data-num { font-size: 52rpx; font-weight: 600; color: var(--color-primary); line-height: 1.3; }
.data-label { font-size: 26rpx; color: var(--color-text-secondary); margin-top: 6rpx; }
.data-tip { font-size: 26rpx; color: var(--color-text-muted); line-height: 1.6; }
