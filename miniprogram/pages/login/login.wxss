/* 登录/绑定页样式：使用设计 token（T-014 迁移） */
.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 100vh;
  padding: 48rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}
.login-page .login-card { margin-top: 30vh; }
.login-page .bind-card { margin-top: 10vh; }
.login-card { width: 100%; text-align: center; padding: 72rpx 40rpx; }
.login-title { font-size: 52rpx; font-weight: 600; margin-bottom: 16rpx; color: var(--color-text); }
.login-desc { color: var(--color-text-secondary); font-size: 30rpx; margin-bottom: 72rpx; }
.login-btn { margin-top: 24rpx; }

/* 绑定昵称 */
.bind-card { width: 100%; padding: 48rpx 32rpx; }
.bind-title { font-size: 40rpx; font-weight: 600; text-align: center; margin-bottom: 12rpx; color: var(--color-text); }
.bind-desc { color: var(--color-text-secondary); font-size: 28rpx; text-align: center; margin-bottom: 36rpx; }
.bind-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 36rpx; }
.bind-item {
  padding: 20rpx 32rpx;
  background: var(--color-bg);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}
.bind-item.active {
  background: var(--color-primary-tint);
  color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 600;
}
.bind-empty {
  text-align: center;
  color: var(--color-text-muted);
  font-size: 28rpx;
  padding: 40rpx 0;
}
.bind-btn { margin-top: 16rpx; }
.bind-btn[disabled] { background: var(--color-border); color: var(--color-text-muted); }

/* 分区 */
.bind-section { margin-top: 32rpx; }
.bind-section-title { font-size: 28rpx; color: var(--color-text-secondary); margin-bottom: 16rpx; }

/* 创建新成员 */
.bind-create-toggle {
  text-align: center; color: var(--color-primary); font-size: 30rpx;
  padding: 20rpx 0; min-height: 88rpx; box-sizing: border-box;
}
.bind-create-form { margin-top: 16rpx; }
.bind-input {
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 32rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  width: 100%;
}
.bind-create-btn { font-size: 32rpx; padding: 18rpx 0; }

/* 管理员跳过 */
.bind-skip {
  text-align: center; color: var(--color-text-muted); font-size: 28rpx;
  margin-top: 40rpx; padding: 16rpx 0;
}

/* 导入排班 */
.bind-import-toggle {
  text-align: center; color: var(--color-primary); font-size: 30rpx;
  padding: 20rpx 0; border-top: 2rpx solid var(--color-border);
  min-height: 88rpx; box-sizing: border-box;
}
.bind-bound-hint {
  text-align: center; color: var(--color-text-muted); font-size: 28rpx;
  padding: 20rpx 0; border-top: 2rpx solid var(--color-border);
}
.bind-enter-btn { margin-top: 24rpx; font-size: 32rpx; padding: 18rpx 0; }
.import-preview-card { margin-top: 32rpx; padding: 32rpx 24rpx; }
.import-bind-section { margin-top: 24rpx; display: flex; align-items: center; gap: 16rpx; }
.import-bind-label { font-size: 30rpx; color: var(--color-text-secondary); white-space: nowrap; }
.import-bind-input { flex: 1; margin-bottom: 0; }

/* 导入排班预览 */
.preview-title { font-size: 36rpx; font-weight: 600; margin-bottom: 8rpx; color: var(--color-text); }
.preview-tip { color: var(--color-warning); font-size: 28rpx; margin-bottom: 24rpx; }
.member-preview { margin-bottom: 28rpx; }
.member-name { font-size: 32rpx; font-weight: 500; margin-bottom: 12rpx; color: var(--color-text); }
.shift-tags { display: flex; flex-wrap: wrap; }
.shift-tag {
  background: var(--color-bg); border-radius: 12rpx; padding: 10rpx 18rpx;
  font-size: 26rpx; color: var(--color-text); margin: 0 12rpx 12rpx 0;
}
.preview-actions { margin-top: 16rpx; }
.preview-actions button { margin-bottom: 16rpx; }
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 100; }
.member-select-panel {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 60rpx; z-index: 101;
  background: var(--color-surface); border-radius: var(--radius-card);
  padding: 32rpx 24rpx 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(20,35,31,0.15);
}
.member-select-title { text-align: center; font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; color: var(--color-text); }
.member-select-list { display: flex; flex-wrap: wrap; }
.member-select-item {
  width: 50%; text-align: center; padding: 24rpx 0; font-size: 30rpx; color: var(--color-text);
  background: var(--color-bg); border-radius: 12rpx; margin: 0 8rpx 16rpx;
  min-height: 88rpx; box-sizing: border-box;
}
.member-select-cancel {
  text-align: center; color: var(--color-text-muted); font-size: 30rpx;
  padding: 20rpx 0; margin-top: 8rpx; min-height: 88rpx; box-sizing: border-box;
}
