.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 100vh;
  padding: 48rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}
.login-page .login-card {
  margin-top: 30vh;
}
.login-page .bind-card {
  margin-top: 10vh;
}
.login-card {
  width: 100%;
  text-align: center;
  padding: 72rpx 40rpx;
}
.login-title {
  font-size: 52rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.login-desc {
  color: #6B7280;
  font-size: 26rpx;
  margin-bottom: 72rpx;
}
.login-btn { margin-top: 24rpx; }

/* 绑定昵称 */
.bind-card {
  width: 100%;
  padding: 48rpx 32rpx;
}
.bind-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 12rpx;
}
.bind-desc {
  color: #6B7280;
  font-size: 24rpx;
  text-align: center;
  margin-bottom: 36rpx;
}
.bind-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 36rpx;
}
.bind-item {
  padding: 16rpx 32rpx;
  background: #F3F4F6;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #374151;
  border: 2rpx solid transparent;
}
.bind-item.active {
  background: #EFF6FF;
  color: #3B82F6;
  border-color: #3B82F6;
  font-weight: 600;
}
.bind-empty {
  text-align: center;
  color: #9CA3AF;
  font-size: 26rpx;
  padding: 40rpx 0;
}
.bind-btn { margin-top: 16rpx; }
.bind-btn[disabled] {
  background: #D1D5DB;
  color: #9CA3AF;
}

/* 分区 */
.bind-section {
  margin-top: 32rpx;
}
.bind-section-title {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 16rpx;
}

/* 创建新成员 */
.bind-create-toggle {
  text-align: center;
  color: #3B82F6;
  font-size: 28rpx;
  padding: 20rpx 0;
}
.bind-create-form {
  margin-top: 16rpx;
}
.bind-input {
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.bind-create-btn {
  font-size: 28rpx;
  padding: 16rpx 0;
}

/* 管理员跳过 */
.bind-skip {
  text-align: center;
  color: #9CA3AF;
  font-size: 24rpx;
  margin-top: 40rpx;
  padding: 16rpx 0;
}

/* 导入排班 */
.bind-import-toggle {
  text-align: center;
  color: #3B82F6;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #E5E7EB;
}
.bind-bound-hint {
  text-align: center;
  color: #9CA3AF;
  font-size: 26rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #E5E7EB;
}
.bind-enter-btn {
  margin-top: 24rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
}
.import-preview-card {
  margin-top: 32rpx;
  padding: 32rpx 24rpx;
}
.import-bind-section {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.import-bind-label {
  font-size: 28rpx;
  color: #374151;
  white-space: nowrap;
}
.import-bind-input {
  flex: 1;
  margin-bottom: 0;
}

/* 导入排班预览 */
.preview-title { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.preview-tip { color: #F59E0B; font-size: 24rpx; margin-bottom: 24rpx; }
.member-preview { margin-bottom: 28rpx; }
.member-name { font-size: 30rpx; font-weight: 500; margin-bottom: 12rpx; }
.shift-tags { display: flex; flex-wrap: wrap; }
.shift-tag {
  background: #F3F4F6; border-radius: 12rpx; padding: 8rpx 16rpx;
  font-size: 24rpx; color: #1F2937; margin: 0 12rpx 12rpx 0;
}
.preview-actions { margin-top: 16rpx; }
.preview-actions button { margin-bottom: 16rpx; }
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 100; }
.member-select-panel {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 60rpx; z-index: 101;
  background: #FFFFFF; border-radius: 24rpx; padding: 32rpx 24rpx 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.15);
}
.member-select-title { text-align: center; font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; color: #1F2937; }
.member-select-list { display: flex; flex-wrap: wrap; }
.member-select-item {
  width: 50%; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: #1F2937;
  background: #F3F4F6; border-radius: 12rpx; margin: 0 8rpx 16rpx;
}
.member-select-cancel {
  text-align: center; color: #9CA3AF; font-size: 28rpx; padding: 16rpx 0; margin-top: 8rpx;
}
